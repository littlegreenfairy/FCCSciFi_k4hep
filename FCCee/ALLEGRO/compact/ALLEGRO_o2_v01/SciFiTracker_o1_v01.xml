<lccdd>

<readouts>
    <readout name="SciFiTrackerCollection">
        <id>system:5,side:1,strip:10,pixelX:3,pixelY:5</id>
        <!-- the system field identifies the subdetector -->
    </readout>
</readouts>

<display>
  <vis name="SciFi:FiberCoreVis"  r="0.9" g="0.9" b="0.1" alpha="1.0" showDaughters="true" visible="true"/>
  <vis name="SciFi:FiberClad1Vis" r="0.5" g="0.8" b="1.0" alpha="0.6" showDaughters="true" visible="true"/>
  <vis name="SciFi:FiberClad2Vis" r="0.3" g="0.5" b="0.9" alpha="0.4" showDaughters="true" visible="true"/>
  <vis name="SciFi:MatVis"        r="0.8" g="0.8" b="0.8" alpha="0.15" showDaughters="true" visible="true"/>
</display>

<!-- SciFi tracker parameters -->

<define>

<!-- Mat Parameters -->

<constant name = "SciFi:nLayers"  value = "4"/>
<!-- SciFi:matWidth is defined once, in DectDimensions.xml, to avoid a silent duplicate-definition conflict -->
<constant name = "SciFi:bendAngle" value = "10.0*deg"/>
<constant name = "SciFi:bendDirection" value = "-1"/>
<constant name = "SciFi:twistAngle" value = "0.0*deg"/>

<!-- For now simulating only 1 mat from station 2 layer 1 -->
<constant name = "SciFi:barrelRadius"  value = "886.8*mm"/>


<!-- SCSF-78 fibre parameters -->
<constant name = "SciFi:fibreRadius"  value = "0.125*mm"/>
<!-- SciFi:fibreLength is defined once, in DectDimensions.xml, to avoid a silent duplicate-definition conflict -->
<constant name = "SciFi:coreFraction"  value = "0.88"/>
<constant name = "SciFi:clad1Fraction"  value = "0.94"/>
<constant name = "SciFi:clad2Fraction"  value = "1.0"/>
<constant name = "SciFi:decayTimeFast"  value = "1.2"/>
<constant name = "SciFi:decayTimeSlow"  value = "1.2"/>
<constant name = "SciFi:yieldRatio"  value = "0.8"/>

<constant name = "SciFi:interfaceLossProb"  value = "14e-4"/>

<!-- SiPM parameters -->

<constant name = "SciFi:airGapSensitive"          value = "0.05*mm"/>
<constant name = "SciFi:stripThickness"           value = "0.0123*mm"/>
<constant name = "SciFi:stripWidth"               value = "0.25*mm"/>
<constant name = "SciFi:stripHeight"              value = "1.6*mm"/>
<constant name = "SciFi:npixelPerStripWidth"      value = "5"/>
<constant name = "SciFi:npixelPerStripHeight"     value = "32"/>
<constant name = "SciFi:pixelSensitiveRatio"      value = "0.67"/>
<constant name = "SciFi:pixelThickness"           value = "0.25*mm"/>


</define>

<includes>
  <file ref="SciFi_materials.xml"/>
</includes>

<detectors>
  <detector
      id="DetID_SciFi_Barrel"
      name="SciFiTracker"
      type="LHCb_SciFi_geo_v1_0"
      readout="SciFiTrackerCollection"
      >
  </detector>
</detectors>

</lccdd>